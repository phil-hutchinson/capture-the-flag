{
    "name": "capture-the-flag (CUDA)",
    // Same Dockerfile as the CPU configuration — the two must not drift, so
    // there is one image definition and the only difference is the build
    // argument below. The build context is .devcontainer (the Dockerfile's own
    // directory, matching the CPU configuration): the Dockerfile COPYs nothing,
    // and pointing the context at the repository root would ship the whole
    // workspace — including training artifacts — to the daemon on every build.
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "args": {
            // GPU-capable wheels of the same torch version the CPU
            // configuration installs. cu126 rather than a newer index: it is
            // the widest driver compatibility that still covers this
            // developer's card, and torch's CUDA minor-version compatibility
            // means a cu126 build runs on any CUDA 12.x-capable driver.
            "TORCH_INDEX_URL": "https://download.pytorch.org/whl/cu126"
        }
    },
    "features": {
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    // Persist Claude Code auth/settings/history across container rebuilds.
    // CLAUDE_CONFIG_DIR keeps the .claude.json state file (onboarding, account
    // metadata) inside the mounted dir too — by default it sits at ~/.claude.json,
    // outside the volume, and is lost on rebuild.
    "mounts": [
        "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
    ],
    "containerEnv": {
        // Nothing personal here: containerEnv becomes `docker run -e`, which
        // overrides --env-file, so entries added here would clobber
        // devcontainer.env values of the same name.
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },
    // Personal, machine-local environment (e.g. TZ=America/Vancouver) goes in
    // .devcontainer/devcontainer.env — gitignored, KEY=VALUE lines, applied
    // container-wide. devcontainer.env.example is the template to rename. Note
    // the path is relative to the workspace folder, not to this file: both
    // configurations share the one env file.
    //
    // --gpus all is what this configuration exists for. It hands the host GPU
    // to the container; under Docker Desktop's WSL2 backend the NVIDIA
    // container runtime also injects /dev/dxg and the WSL driver libraries,
    // which is what makes torch.cuda.is_available() true inside.
    "runArgs": [
        "--env-file", ".devcontainer/devcontainer.env",
        "--gpus", "all"
    ],
    // Docker fails on a missing --env-file, so ensure it exists before the
    // container starts. Runs on the host: `touch` covers sh, `type NUL >>`
    // covers cmd (Windows). touch must come first — cmd's "not recognized"
    // complaint goes to the console, but dash prints the type failure to
    // stdout, which the >> would otherwise capture into the env file.
    "initializeCommand": "cd .devcontainer && (touch devcontainer.env || type NUL >> devcontainer.env)",
    // 1) Repair ownership on volumes created before the image pre-created the
    //    directory (Docker makes bare mount points root-owned).
    // 2) Install the project editable into the container's Python — no .venv;
    //    the container is the isolation boundary. This pulls the pinned
    //    game-engine-core dependency (with its learning extra, torch/numpy —
    //    already baked into the image) from GitHub, so it links the workspace
    //    source and clones one git dependency — fast on rebuild. The CUDA wheel
    //    survives this: game-engine-core asks for torch>=2.0, which the
    //    installed 2.13.0+cu126 already satisfies, so pip leaves it alone.
    "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && pip install --editable '.'",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff"
            ],
            "settings": {
                // Use the image's pinned ruff instead of the binary bundled
                // with the extension, so the editor and `ruff check` agree.
                "ruff.importStrategy": "fromEnvironment"
            }
        }
    }
}
